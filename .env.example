# ===== NVR_Home cấu hình =====
# Sao chép file này thành .env rồi sửa giá trị

# Mật khẩu tài khoản admin (chỉ dùng lần đầu khởi tạo; sau đó đổi trong app)
NVR_ADMIN_PASSWORD=changeme

# Secret để ký token đăng nhập (bỏ trống sẽ tự sinh và lưu vào DB)
NVR_JWT_SECRET=

# Địa chỉ go2rtc nhìn từ backend (trong docker-compose dùng tên service)
GO2RTC_URL=http://go2rtc:1984
# RTSP restream của go2rtc (recorder/detector nối vào đây, mỗi camera 1 kết nối)
GO2RTC_RTSP=rtsp://go2rtc:8554

# Múi giờ ảnh hưởng tới tên thư mục ghi hình
TZ=Asia/Ho_Chi_Minh
